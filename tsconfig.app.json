{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"moduleDetection": "force",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"jsx": "react-jsx",
		"types": ["vitest/globals"],
		"strict": true,
		"noEmit": true
	},
	"include": ["src"]
}
